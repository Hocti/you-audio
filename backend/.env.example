DATABASE_URL=postgresql+asyncpg://ytaudio:ytaudio@db:5432/ytaudio
DATA_DIR=/data
# Seeds the default `admin` user's token on first boot only (auth is per-user
# via the `users` table after that). If left empty, a random admin token is
# generated and printed to the logs.
ACCESS_TOKEN=change_me_to_a_random_secret
YOUTUBE_API_KEY=your_youtube_data_api_v3_key
